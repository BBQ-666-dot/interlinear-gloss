{
  "name": "interlinear-gloss",
  "version": "0.4.0",
  "description": "Persistent bilingual translations and word glosses below selected text (Obsidian plugin).",
  "author": "bbq25",
  "repository": {
    "type": "git",
    "url": "https://github.com/BBQ-666-dot/interlinear-gloss.git"
  },
  "homepage": "https://github.com/BBQ-666-dot/interlinear-gloss#readme",
